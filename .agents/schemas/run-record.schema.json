{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-record.schema.json",
  "title": "Append-only Harness Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "packet_id",
    "attempt",
    "agent",
    "model",
    "started_at",
    "ended_at",
    "contract_refs",
    "owned_paths",
    "worktree",
    "base_commit",
    "result_commit",
    "result",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "agent": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "contract_refs": {"type": "array", "items": {"type": "string", "pattern": "^C-[0-9]{3}@v[1-9][0-9]*$"}, "uniqueItems": true},
    "owned_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "worktree": {"type": ["string", "null"]},
    "base_commit": {"type": ["string", "null"]},
    "result_commit": {"type": ["string", "null"]},
    "result": {"$ref": "agent-result.schema.json"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "input_tokens", "output_tokens", "elapsed_seconds"],
      "properties": {
        "turns": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "elapsed_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
