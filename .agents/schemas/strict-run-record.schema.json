{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strict-run-record.schema.json",
  "title": "Strict Append-only Run Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "packet_id", "attempt", "agent", "model", "started_at", "ended_at", "contract_refs", "owned_paths", "worktree", "base_commit", "result_commit", "result", "metrics"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "pattern": "^WP-[A-Z0-9-]+$"},
    "attempt": {"type": "integer", "minimum": 1},
    "agent": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "contract_refs": {"type": "array", "items": {"type": "string", "pattern": "^C-[0-9]{3}@v[1-9][0-9]*$"}, "uniqueItems": true},
    "owned_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "worktree": {"type": ["string", "null"]},
    "base_commit": {"type": ["string", "null"]},
    "result_commit": {"type": ["string", "null"]},
    "result": {"$ref": "strict-agent-result.schema.json"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "input_tokens", "output_tokens", "reasoning_tokens", "tool_calls", "elapsed_seconds", "estimated_cost_usd"],
      "properties": {
        "turns": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
