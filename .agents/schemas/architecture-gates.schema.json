{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-gates.schema.json",
  "title": "Architecture Gate Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "domains", "contract_refs", "decision_artifact", "evidence_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^AG-[0-9]{3}$"},
          "status": {"enum": ["pending", "approved", "rejected"]},
          "domains": {"type": "array", "items": {"type": "string", "pattern": "^D-[A-Z0-9-]+$"}, "uniqueItems": true},
          "contract_refs": {"type": "array", "items": {"type": "string", "pattern": "^C-[0-9]{3}@v[1-9][0-9]*$"}, "uniqueItems": true},
          "decision_artifact": {"type": "string", "minLength": 1},
          "evidence_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
