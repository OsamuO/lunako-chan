{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dependency-graph.schema.json",
  "title": "Domain Dependency Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "nodes": {"type": "array", "items": {"type": "string", "pattern": "^D-[A-Z0-9-]+$"}, "uniqueItems": true},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind", "contracts"],
        "properties": {
          "from": {"type": "string", "pattern": "^D-[A-Z0-9-]+$"},
          "to": {"type": "string", "pattern": "^D-[A-Z0-9-]+$"},
          "kind": {"enum": ["depends-on", "data-flow", "control-flow"]},
          "contracts": {"type": "array", "items": {"type": "string", "pattern": "^C-[0-9]{3}@v[1-9][0-9]*$"}, "uniqueItems": true}
        }
      }
    }
  }
}
